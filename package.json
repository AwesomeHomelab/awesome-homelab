{
  "name": "awesome-metrix-bar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp run types",
    "messages:build": "paraglide-js compile --project ./project.inlang",
    "styles": "panda codegen",
    "registry:build": "node scripts/build-registry.ts && node scripts/build-avatars.ts",
    "registry:history": "node scripts/verify-history.ts",
    "types": "void prepare && panda codegen && vp run messages:build",
    "dev": "vp run registry:build && vp dev",
    "build": "vp run registry:build && vp build",
    "check": "vp check",
    "test": "vp test",
    "preview": "vp run build && vp preview",
    "deploy": "vp run build && cf deploy --prebuilt --mode production",
    "deploy:dry-run": "vp run build && cf deploy --prebuilt --mode production --dry-run",
    "verify": "vp run registry:build && vp run types && vp check && vp test && vp build",
    "verify:http": "node scripts/verify-http.ts"
  },
  "dependencies": {
    "@ui-sdk/core": "^0.1.0-beta.1",
    "@ui-sdk/react": "^0.1.0-beta.1",
    "@void/react": "^1.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@pandacss/vite": "^2.5.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cf": "^1.0.0-beta.28",
    "cheerio": "^1.2.0",
    "semver": "^7.8.6",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.5.0",
    "vite-plus": "^1.5.0",
    "vitest": "^5.1.0",
    "void": "^1.7.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": "12.x"
  },
  "packageManager": "pnpm@12.18.0"
}
